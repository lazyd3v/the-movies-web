 static int g_log_imports = -1;
 __thread uint32_t g_import_target;  /* which host slot the current import call came through */
 
+/* Post-import observation point: host handler has completed stdcall return.
+ * Strong overrides may pump deferred callbacks. Guest-memory side effects are
+ * retained, but the completed import CPU result and caller import identity are
+ * preserved. Recursive imports during pumping do not recursively pump again.
+ * Hooks must not retain this CPU pointer or unwind and resume through this frame. */
+__attribute__((weak)) int movies_import_needs_callback(uint32_t target) { (void)target; return 0; }
+__attribute__((weak)) void movies_after_import(CPU *c) { (void)c; }
+static __thread unsigned import_hook_active;
+static void dispatch_completed_import(CPU *c, GuestFn fn, uint32_t target) {
+    if(target<IMPORT_BASE){fn(c);return;}
+    uint32_t previous=g_import_target;
+    g_import_target=target;
+    fn(c);
+    g_import_target=target;
+    if(!import_hook_active && movies_import_needs_callback(target)){
+        CPU completed=*c;
+        import_hook_active=1;
+        movies_after_import(c);
+        import_hook_active=0;
+        *c=completed;
+        fpu_sync_rounding(c);
+    }
+    g_import_target=previous;
+}
