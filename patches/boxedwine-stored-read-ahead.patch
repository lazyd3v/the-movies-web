@@ -0,0 +1,43 @@
+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+#include <cstring>
+#include <vector>
+
+// Per-open-file cache for immutable ZIP_STORED members. No browser FS calls
+// occur on hits. Allocate lazily so unopened/unread members cost no buffer.
+class FsStoredReadCache {
+public:
+    void clear() { bytes.clear(); start = 0; valid = 0; }
+
+    template<class Reader>
+    int64_t read(uint64_t position, uint64_t fileSize, uint8_t* output,
+                 uint32_t length, Reader&& reader) {
+        if (position >= fileSize || !length) return 0;
+        const uint32_t wanted = (uint32_t)std::min<uint64_t>(length, fileSize - position);
+        uint32_t copied = 0;
+        while (copied < wanted) {
+            const uint64_t at = position + copied;
+            if (!valid || at < start || at - start >= valid) {
+                const uint32_t count = (uint32_t)std::min<uint64_t>(256 * 1024, fileSize - at);
+                if (bytes.size() < count) bytes.resize(count);
+                valid = 0;
+                int64_t result = reader(at, bytes.data(), count);
+                if (result <= 0) return copied ? copied : result;
+                if ((uint64_t)result > count) return copied ? copied : -1;
+                start = at;
+                valid = (uint32_t)result;
+            }
+            const uint32_t inside = (uint32_t)(at - start);
+            const uint32_t count = std::min(wanted - copied, valid - inside);
+            std::memcpy(output + copied, bytes.data() + inside, count);
+            copied += count;
+        }
+        return copied;
+    }
+private:
+    std::vector<uint8_t> bytes;
+    uint64_t start = 0;
+    uint32_t valid = 0;
+};
